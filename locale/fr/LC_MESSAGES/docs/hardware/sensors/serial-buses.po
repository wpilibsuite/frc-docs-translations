msgid "`I2C`_"
msgstr "`I2C`_"

#: ../../frc-docs/source/docs/hardware/sensors/serial-buses.rst:16
msgid "`USB Host`_"
msgstr "`USB Host`_"

#: ../../frc-docs/source/docs/hardware/sensors/serial-buses.rst:17
