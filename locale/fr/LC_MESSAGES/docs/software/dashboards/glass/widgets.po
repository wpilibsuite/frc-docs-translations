msgstr "``DigitalInput``"

#: ../../frc-docs/source/docs/software/dashboards/glass/widgets.rst:20
msgid "``DigitalOutput``"
msgstr "``DigitalOutput``"

#: ../../frc-docs/source/docs/software/dashboards/glass/widgets.rst:21
msgid "``SpeedController``"
msgstr "``SpeedController``"

